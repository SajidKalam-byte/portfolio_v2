# =============================================================================
# Sajid Kalam — portfolio
# Copy to .env and fill in. NEVER upload .env anywhere inside public_html.
# After changing .env on the server, clear cached config (admin → Dashboard →
# "Clear all caches", or `php artisan optimize:clear`).
# =============================================================================

APP_NAME="Sajid Kalam"
# production | local. Anything other than production serves noindex headers
# and a "Disallow: /" robots.txt so staging copies never get indexed.
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# Your final domain, with https:// and no trailing slash. Used for canonical
# URLs, the sitemap, and Open Graph tags.
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Kolkata

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# --- Database (cPanel → MySQL® Databases) -----------------------------------
# cPanel prefixes names with your account user, e.g. cpuser_portfolio.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpuser_portfolio
DB_USERNAME=cpuser_portfolio
DB_PASSWORD=

# --- Sessions, cache, queue: no background workers needed on shared hosting --
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Requires HTTPS. Set to false only while testing without SSL.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# --- Mail (optional) ----------------------------------------------------------
# With MAIL_MAILER=log no emails are sent; contact messages are still saved and
# visible in the admin. For BigRock, create a mailbox in cPanel → Email Accounts
# and use the SMTP details shown under "Connect Devices".
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mail.your-domain.example
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

# --- Portfolio ----------------------------------------------------------------
# Everything below can also be changed in admin → Settings (stored in the DB).

# One public address only. Confirm before publishing.
PORTFOLIO_PUBLIC_EMAIL=sajid.kalam.dev@gmail.com
PORTFOLIO_SHOW_EMAIL=true
# Phone stays hidden unless PORTFOLIO_SHOW_PHONE=true.
PORTFOLIO_PHONE=
PORTFOLIO_SHOW_PHONE=false
PORTFOLIO_LOCATION="Siliguri, West Bengal, India"
PORTFOLIO_STATUS_TEXT="Associate Engineer at Corunit Media Corp"
PORTFOLIO_OPEN_TO_WORK=false
PORTFOLIO_OPEN_TO_WORK_TEXT="Open to backend & full-stack opportunities"
PORTFOLIO_GITHUB_URL=https://github.com/SajidKalam-byte
PORTFOLIO_LINKEDIN_URL=https://www.linkedin.com/in/sajid-kalam/

# Resume PDF path relative to the public folder. The download button only
# appears when this file exists. PORTFOLIO_RESUME_URL is an optional fallback.
PORTFOLIO_RESUME_PATH=files/sajid-kalam-resume.pdf
PORTFOLIO_RESUME_URL=

# Adds `worksFor: Corunit Media Corp` to structured data once confirmed.
PORTFOLIO_SCHEMA_WORKS_FOR=false
PORTFOLIO_EMPLOYER_URL=

# Contact form: where new-message notifications go (needs working MAIL_*).
PORTFOLIO_NOTIFY_EMAIL=
PORTFOLIO_CONTACT_MAX_PER_HOUR=5

# Admin area. Change the path to reduce bot noise; disable entirely if you
# prefer to manage content only through seeders/phpMyAdmin.
PORTFOLIO_ADMIN_ENABLED=true
PORTFOLIO_ADMIN_PATH=admin

PORTFOLIO_CSP=true
PORTFOLIO_CACHE_TTL=3600
PORTFOLIO_TWITTER_HANDLE=
PORTFOLIO_PHOTO=
PORTFOLIO_GOOGLE_SITE_VERIFICATION=

VITE_APP_NAME="${APP_NAME}"
